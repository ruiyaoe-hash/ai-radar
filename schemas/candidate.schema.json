{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ruiyaoe-hash.github.io/ai-radar/schemas/candidate.schema.json",
  "title": "AI Radar candidate pool record",
  "description": "Contract for one row in the private ai-radar-pool JSONL. The public repo keeps this schema only. Do not commit pool JSONL, third-party full text, or drop dumps here. status_in_pool is circulation (池内状态). drop_reason is a true drop (真丢弃) only: pending, wrong_lane, quota, and quota_defer are not drop reasons. no_new_info and low_score are true drops. Optional score is the post-gate rules score from scripts/score_pool.py. It is not a public ranker and is not a publish condition by itself.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "url",
    "url_norm",
    "ingested_at",
    "source",
    "participation",
    "tier_prior",
    "prefilter",
    "status_in_pool"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^cand-[0-9]{8}-[a-f0-9]{12}$",
      "description": "Stable candidate id (cid). cand-YYYYMMDD- plus 12 hex chars. The date is the Asia/Shanghai calendar day of published_at, else of ingested_at. The suffix hashes the status id when the post has one, else the normalized URL."
    },
    "url": { "type": "string", "minLength": 1 },
    "url_norm": {
      "type": "string",
      "minLength": 1,
      "description": "Normalized permalink. https, host x.com for X posts, tracking query removed."
    },
    "title": { "type": ["string", "null"] },
    "snippet": {
      "type": ["string", "null"],
      "description": "Source text. Private pool only. Never copy this into the public repo. Public validate rejects this key on public JSON; public cards publish edited objective text instead."
    },
    "published_at": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|\\+00:00)$"
    },
    "ingested_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|\\+00:00)$",
      "description": "When ingest_x wrote the skeleton. ISO-8601 UTC. Not a judgment."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "handle", "role_guess"],
      "properties": {
        "channel": { "type": "string", "enum": ["x", "rss", "web"] },
        "handle": { "type": ["string", "null"] },
        "role_guess": {
          "type": ["string", "null"],
          "enum": ["primary", "analysis", "report", null],
          "description": "Judgment. ingest_x leaves this null."
        }
      }
    },
    "tier_prior": {
      "type": ["string", "null"],
      "description": "Trust prior (信任先验), e.g. a_tier. Not an ingest gate. Null until a judgment pass."
    },
    "participation": {
      "type": ["string", "null"],
      "enum": ["editorial", "practice", "hot_signal", null],
      "description": "Judgment. practice_handles default to practice in a later routing phase. ingest_x leaves this null."
    },
    "lane_hint": {
      "type": ["string", "null"],
      "enum": ["digest", "practice", "tools", null]
    },
    "prefilter": {
      "type": ["string", "null"],
      "enum": ["PASS", "BLOCK", "UNKNOWN", null],
      "description": "Gate annotation (门槛标注). BLOCK still keeps the pool row. Null at ingest."
    },
    "cluster_id": { "type": ["string", "null"] },
    "status_in_pool": {
      "type": "string",
      "enum": ["pending", "active", "deferred", "rerouted", "promoted", "dropped"],
      "description": "Pool status (池内状态). pending=已入池，门槛/评分未完; active=在池可晋升; deferred=延后，非真丢; rerouted=改道，非真丢; promoted=已写公开卡; dropped=真丢弃，必须有 drop_reason. ingest_x always writes pending."
    },
    "drop_reason": {
      "description": "True-drop reason (真丢弃原因). Required iff status_in_pool=dropped; otherwise null. Includes no_new_info. Does not include pending, wrong_lane, quota, or quota_defer.",
      "anyOf": [
        { "type": "null" },
        {
          "type": "string",
          "enum": [
            "prefilter_block",
            "prefilter_unknown",
            "not_opc_action",
            "rumor_no_upgrade",
            "media_alone",
            "duplicate_event",
            "duplicate_url",
            "stale_old",
            "no_reliable_time",
            "no_new_info",
            "practice_not_steps",
            "hot_signal_only",
            "editor_skip",
            "low_score"
          ]
        }
      ]
    },
    "engagement": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional counts copied at ingest from the raw fetch (public_metrics or like/bookmark fields). Not a judgment. Absent when the fetch had no counts. RSS rows usually omit this.",
      "properties": {
        "likes": { "type": "integer", "minimum": 0 },
        "bookmarks": { "type": "integer", "minimum": 0 },
        "reposts": { "type": "integer", "minimum": 0 },
        "replies": { "type": "integer", "minimum": 0 },
        "quotes": { "type": "integer", "minimum": 0 },
        "views": { "type": "integer", "minimum": 0 },
        "captured_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|\\+00:00)$"
        }
      }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "description": "Rules score written after annotate gates. value is prior × decay × corroboration × velocity, plus a capped actionability term, then clamped to [0, 1]. practice never uses band auto_brief. llm stays null unless a future adapter is configured; this repo does not call a hosted model.",
      "required": ["value", "band", "band_reason", "primary_source", "method", "components", "llm"],
      "properties": {
        "value": { "type": "number", "minimum": 0, "maximum": 1 },
        "band": { "type": "string", "enum": ["auto_brief", "review", "drop"] },
        "band_reason": {
          "type": "string",
          "enum": [
            "auto_primary",
            "review_score",
            "review_practice",
            "review_no_primary",
            "review_deferred",
            "drop_low_score"
          ]
        },
        "primary_source": { "type": "boolean" },
        "method": { "type": "string", "enum": ["rules", "llm"] },
        "components": {
          "type": "object",
          "additionalProperties": false,
          "required": ["prior", "decay", "corroboration", "velocity", "actionability"],
          "properties": {
            "prior": { "type": "number" },
            "decay": { "type": "number" },
            "corroboration": { "type": "number" },
            "velocity": { "type": "number" },
            "actionability": { "type": "number" }
          }
        },
        "llm": {
          "description": "Reserved structured judge. Rules scoring writes null. If AI_RADAR_SCORE_LLM_URL is set, the current adapter writes skipped_reason and does not POST the row.",
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["skipped_reason"],
              "properties": {
                "model": { "type": "string" },
                "actionability": { "type": "number" },
                "label": { "type": "string" },
                "skipped_reason": { "type": "string" }
              }
            }
          ]
        }
      }
    },
    "atlas_suggestion": {
      "type": "object",
      "additionalProperties": false,
      "description": "Topic suggestion from scripts/suggest_atlas_topics.py. Advisory only. verified mirrors a public practice card when one exists; it does not publish a handbook. apply is never an automatic write. reason must not copy snippet or steps.",
      "required": ["topic", "reason", "verified", "apply", "lane"],
      "properties": {
        "topic": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
          ]
        },
        "reason": { "type": "string", "minLength": 1, "maxLength": 240 },
        "verified": { "type": "boolean" },
        "apply": { "type": "string", "enum": ["held", "blocked_unverified", "no_topic"] },
        "lane": { "type": "string", "minLength": 1, "maxLength": 40 },
        "matched_on": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "maxLength": 80 }
        }
      }
    },
    "brief_id": {
      "type": "string",
      "pattern": "^brf-[0-9]{8}-[a-z0-9][a-z0-9-]{0,80}$",
      "description": "Public L2 brief id after derive_briefs publishes this row. Absent until then. Not an L1 archive id."
    },
    "archive_id": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "string",
          "pattern": "^(evt|prac)-[0-9]{8}-[a-z0-9][a-z0-9-]{0,80}$"
        }
      ],
      "description": "Public card id after promotion. Required when status_in_pool=promoted."
    },
    "promotion_path": {
      "type": ["string", "null"],
      "enum": ["normal", "emergency", null],
      "description": "normal = left the pool through promotion. emergency is a card-side exception and is not a pool status."
    },
    "notes": { "type": "string" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status_in_pool": { "const": "dropped" } },
        "required": ["status_in_pool"]
      },
      "then": {
        "required": ["drop_reason"],
        "properties": {
          "drop_reason": {
            "type": "string",
            "enum": [
              "prefilter_block",
              "prefilter_unknown",
              "not_opc_action",
              "rumor_no_upgrade",
              "media_alone",
              "duplicate_event",
              "duplicate_url",
              "stale_old",
              "no_reliable_time",
              "no_new_info",
              "practice_not_steps",
              "hot_signal_only",
              "editor_skip",
              "low_score"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "drop_reason": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": { "status_in_pool": { "const": "promoted" } },
        "required": ["status_in_pool"]
      },
      "then": {
        "required": ["archive_id"],
        "properties": {
          "archive_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(evt|prac)-[0-9]{8}-[a-z0-9][a-z0-9-]{0,80}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": { "drop_reason": { "enum": ["editor_skip", "low_score"] } },
        "required": ["drop_reason"]
      },
      "then": {
        "required": ["notes"],
        "properties": {
          "notes": { "type": "string", "minLength": 1 }
        }
      }
    }
  ]
}
