{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ruiyaoe-hash.github.io/ai-radar/schemas/candidate.schema.json",
  "title": "AI Radar candidate pool record",
  "description": "Contract for one row in the private ai-radar-pool JSONL. The public repo keeps this schema only. Do not commit pool JSONL, third-party full text, or drop dumps here. status_in_pool is circulation (池内状态). drop_reason is a true drop (真丢弃) only: pending, wrong_lane, quota, and quota_defer are not drop reasons. no_new_info and low_score are true drops. Optional score is the post-gate rules score from scripts/score_pool.py. It is not a public ranker and is not a publish condition by itself.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "url",
    "url_norm",
    "ingested_at",
    "source",
    "participation",
    "tier_prior",
    "prefilter",
    "status_in_pool"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^cand-[0-9]{8}-[a-f0-9]{12}$",
      "description": "Stable candidate id (cid). cand-YYYYMMDD- plus 12 hex chars. The date is the Asia/Shanghai calendar day of published_at, else of ingested_at. The suffix hashes the status id when the post has one, else the normalized URL."
    },
    "url": { "type": "string", "minLength": 1 },
    "url_norm": {
      "type": "string",
      "minLength": 1,
      "description": "Normalized permalink. https, host x.com for X posts, tracking query removed."
    },
    "title": { "type": ["string", "null"] },
    "snippet": {
      "type": ["string", "null"],
      "description": "Source text. Private pool only. Never copy this into the public repo. Public validate rejects this key on public JSON; public cards publish edited objective text instead."
    },
    "published_at": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|\\+00:00)$"
    },
    "ingested_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|\\+00:00)$",
      "description": "When ingest_x wrote the skeleton. ISO-8601 UTC. Not a judgment."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "handle", "role_guess"],
      "properties": {
        "channel": { "type": "string", "enum": ["x", "rss", "web"] },
        "handle": { "type": ["string", "null"] },
        "role_guess": {
          "type": ["string", "null"],
          "enum": ["primary", "analysis", "report", null],
          "description": "Judgment. ingest_x leaves this null."
        }
      }
    },
    "tier_prior": {
      "type": ["string", "null"],
      "description": "Trust prior (信任先验), e.g. a_tier. Not an ingest gate. Null until a judgment pass."
    },
    "participation": {
      "type": ["string", "null"],
      "enum": ["editorial", "practice", "hot_signal", null],
      "description": "Judgment. practice_handles default to practice in a later routing phase. ingest_x leaves this null."
    },
    "lane_hint": {
      "type": ["string", "null"],
      "enum": ["digest", "practice", "tools", null]
    },
    "prefilter": {
      "type": ["string", "null"],
      "enum": ["PASS", "BLOCK", "UNKNOWN", null],
      "description": "Gate annotation (门槛标注). BLOCK still keeps the pool row. Null at ingest."
    },
    "cluster_id": { "type": ["string", "null"] },
    "status_in_pool": {
      "type": "string",
      "enum": ["pending", "active", "deferred", "rerouted", "promoted", "dropped"],
      "description": "Pool status (池内状态). pending=已入池，门槛/评分未完; active=在池可晋升; deferred=延后，非真丢; rerouted=改道，非真丢; promoted=已写公开卡; dropped=真丢弃，必须有 drop_reason. ingest_x always writes pending."
    },
    "drop_reason": {
      "description": "True-drop reason (真丢弃原因). Required iff status_in_pool=dropped; otherwise null. Includes no_new_info. Does not include pending, wrong_lane, quota, or quota_defer.",
      "anyOf": [
        { "type": "null" },
        {
          "type": "string",
          "enum": [
            "prefilter_block",
            "prefilter_unknown",
            "not_opc_action",
            "rumor_no_upgrade",
            "media_alone",
            "duplicate_event",
            "duplicate_url",
            "stale_old",
            "no_reliable_time",
            "no_new_info",
            "practice_not_steps",
            "hot_signal_only",
            "editor_skip",
            "low_score"
          ]
        }
      ]
    },
    "engagement": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional counts copied at ingest from the raw fetch (public_metrics or like/bookmark fields). Not a judgment. Absent when the fetch had no counts. RSS rows usually omit this.",
      "properties": {
        "likes": { "type": "integer", "minimum": 0 },
        "bookmarks": { "type": "integer", "minimum": 0 },
        "reposts": { "type": "integer", "minimum": 0 },
        "replies": { "type": "integer", "minimum": 0 },
        "quotes": { "type": "integer", "minimum": 0 },
        "views": { "type": "integer", "minimum": 0 },
        "captured_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|\\+00:00)$"
        }
      }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "description": "Rules score written after annotate gates. value is the v1 control: prior × decay × corroboration × velocity, plus a capped actionability term, then clamped to [0, 1]. source_reliability, evidence_grade, and content_value are stored separately so a high tier_prior cannot hide a report role. Optional v2 is the shadow multi-axis score; band stays on v1 unless config score.active_scorer is v2. practice never uses band auto_brief, and auto_brief requires official_source: the row itself is a primary source on an RSS feed. X posts and cluster neighbours of a primary link go to review. Forced P0 uses band_reason review_p0 and does not auto-publish. llm stays null unless a future adapter is configured; this repo does not call a hosted model.",
      "required": ["value", "band", "band_reason", "primary_source", "method", "components", "llm"],
      "if": { "properties": { "band": { "const": "auto_brief" } }, "required": ["band"] },
      "then": { "properties": { "official_source": { "const": true } }, "required": ["official_source"] },
      "properties": {
        "value": { "type": "number", "minimum": 0, "maximum": 1 },
        "band": { "type": "string", "enum": ["auto_brief", "review", "drop"] },
        "band_reason": {
          "type": "string",
          "enum": [
            "auto_primary",
            "review_score",
            "review_practice",
            "review_no_primary",
            "review_not_official",
            "review_deferred",
            "review_p0",
            "drop_low_score"
          ]
        },
        "primary_source": { "type": "boolean" },
        "official_source": { "type": "boolean" },
        "method": { "type": "string", "enum": ["rules", "llm"] },
        "scorer": {
          "type": "string",
          "enum": ["v1", "v2"],
          "description": "Which scorer set band. Default production is v1. v2 may still be stored in shadow."
        },
        "source_reliability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Account or org prior only (tier weight blended with editor hit rate). Does not absorb role_guess."
        },
        "evidence_grade": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "primary / analysis / report grade. A report stays low even when tier_prior is T1."
        },
        "content_value": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "v1 ranking value. Same number as value. Not a user-value label."
        },
        "edition_eligibility": {
          "type": "string",
          "enum": ["eligible", "held_edition", "stale_window"],
          "description": "Today's edition slot. held_edition is a defer, not a low-value drop. stale_window means the publish clock is older than the gate window while the row is still active."
        },
        "components": {
          "type": "object",
          "additionalProperties": false,
          "required": ["prior", "decay", "corroboration", "velocity", "actionability"],
          "properties": {
            "prior": { "type": "number" },
            "decay": { "type": "number" },
            "corroboration": { "type": "number" },
            "velocity": { "type": "number" },
            "actionability": { "type": "number" },
            "spread": {
              "type": "number",
              "description": "Distinct accounts that mentioned the cluster, including homologous reprints. Reach, not independent evidence."
            },
            "independent_evidence": {
              "type": "number",
              "description": "Distinct primary or official URLs among rows that were not dropped as duplicates or no_new_info. Reprints do not add."
            }
          }
        },
        "llm": {
          "description": "Reserved structured judge. Rules scoring writes null. If AI_RADAR_SCORE_LLM_URL is set, the current adapter writes skipped_reason and does not POST the row.",
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["skipped_reason"],
              "properties": {
                "model": { "type": "string" },
                "actionability": { "type": "number" },
                "label": { "type": "string" },
                "skipped_reason": { "type": "string" }
              }
            }
          ]
        },
        "v2": {
          "type": "object",
          "additionalProperties": false,
          "description": "Shadow multi-axis score. p is the experimental blend. confidence is a separate gate. Ignored for band while scorer is v1.",
          "required": ["p", "confidence", "band", "band_reason", "content_type", "dimensions", "weights", "method", "llm"],
          "properties": {
            "p": { "type": "number", "minimum": 0, "maximum": 1 },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "band": { "type": "string", "enum": ["auto_brief", "review", "drop"] },
            "band_reason": { "type": "string" },
            "content_type": {
              "type": "string",
              "enum": ["vuln", "product_launch", "tutorial", "analysis", "default"]
            },
            "dimensions": {
              "type": "object",
              "additionalProperties": false,
              "required": ["importance", "novelty", "relevance", "actionability", "freshness"],
              "properties": {
                "importance": { "type": "number", "minimum": 0, "maximum": 1 },
                "novelty": { "type": "number", "minimum": 0, "maximum": 1 },
                "relevance": { "type": "number", "minimum": 0, "maximum": 1 },
                "actionability": { "type": "number", "minimum": 0, "maximum": 1 },
                "freshness": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            },
            "weights": {
              "type": "object",
              "additionalProperties": false,
              "required": ["importance", "novelty", "relevance", "actionability", "freshness"],
              "properties": {
                "importance": { "type": "number" },
                "novelty": { "type": "number" },
                "relevance": { "type": "number" },
                "actionability": { "type": "number" },
                "freshness": { "type": "number" }
              }
            },
            "method": { "type": "string", "enum": ["rules", "llm"] },
            "llm": {
              "anyOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["skipped_reason"],
                  "properties": {
                    "skipped_reason": { "type": "string" }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "atlas_suggestion": {
      "type": "object",
      "additionalProperties": false,
      "description": "Topic suggestion from scripts/suggest_atlas_topics.py. Advisory only. verified mirrors a public practice card when one exists; it does not publish a handbook. apply is never an automatic write. reason must not copy snippet or steps.",
      "required": ["topic", "reason", "verified", "apply", "lane"],
      "properties": {
        "topic": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
          ]
        },
        "reason": { "type": "string", "minLength": 1, "maxLength": 240 },
        "verified": { "type": "boolean" },
        "apply": { "type": "string", "enum": ["held", "blocked_unverified", "no_topic"] },
        "lane": { "type": "string", "minLength": 1, "maxLength": 40 },
        "matched_on": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "maxLength": 80 }
        }
      }
    },
    "brief_id": {
      "type": "string",
      "pattern": "^brf-[0-9]{8}-[a-z0-9][a-z0-9-]{0,80}$",
      "description": "Public L2 brief id after derive_briefs publishes this row. Absent until then. Not an L1 archive id."
    },
    "archive_id": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "string",
          "pattern": "^(evt|prac)-[0-9]{8}-[a-z0-9][a-z0-9-]{0,80}$"
        }
      ],
      "description": "Public card id after promotion. Required when status_in_pool=promoted."
    },
    "promotion_path": {
      "type": ["string", "null"],
      "enum": ["normal", "emergency", null],
      "description": "normal = left the pool through promotion. emergency is a card-side exception and is not a pool status."
    },
    "force_p0": {
      "type": "object",
      "additionalProperties": false,
      "description": "Forced P0 (强制今日必看通道) written by scripts/force_p0.py. Review queue only. Does not publish the archive or 今日必看. source=code means the pipeline, not an Alba routine, is the authority.",
      "required": ["active", "kinds", "triggers", "default_action", "tool_choice", "bypassed", "source"],
      "properties": {
        "active": { "type": "boolean" },
        "kinds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["frontier_launch", "runtime_vuln", "multi_a_tier"]
          }
        },
        "triggers": {
          "type": "array",
          "items": { "type": "string", "maxLength": 40 }
        },
        "default_action": { "type": "string", "enum": ["promote", "skip"] },
        "tool_choice": { "type": "boolean" },
        "bypassed": {
          "type": "array",
          "items": { "type": "string", "maxLength": 40 }
        },
        "source": { "type": "string", "const": "code" }
      }
    },
    "card_copy": {
      "type": "object",
      "additionalProperties": false,
      "description": "Words for a card. Not a score. watch_reason is a fixed sentence with no digits and no post body. evidence_label and suggested_action are the public labels. high_priority_review means Forced P0 is waiting for a person; it does not publish the archive or a brief.",
      "required": ["watch_reason", "evidence_label", "suggested_action", "high_priority_review"],
      "properties": {
        "watch_reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[^0-9]*$"
        },
        "evidence_label": {
          "type": "string",
          "enum": ["官方原始信息", "多源确认", "尚待核实"]
        },
        "suggested_action": {
          "type": "string",
          "enum": ["立即试用", "持续观察", "暂缓"]
        },
        "high_priority_review": { "type": "boolean" }
      }
    },
    "notes": { "type": "string" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status_in_pool": { "const": "dropped" } },
        "required": ["status_in_pool"]
      },
      "then": {
        "required": ["drop_reason"],
        "properties": {
          "drop_reason": {
            "type": "string",
            "enum": [
              "prefilter_block",
              "prefilter_unknown",
              "not_opc_action",
              "rumor_no_upgrade",
              "media_alone",
              "duplicate_event",
              "duplicate_url",
              "stale_old",
              "no_reliable_time",
              "no_new_info",
              "practice_not_steps",
              "hot_signal_only",
              "editor_skip",
              "low_score"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "drop_reason": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": { "status_in_pool": { "const": "promoted" } },
        "required": ["status_in_pool"]
      },
      "then": {
        "required": ["archive_id"],
        "properties": {
          "archive_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(evt|prac)-[0-9]{8}-[a-z0-9][a-z0-9-]{0,80}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": { "drop_reason": { "enum": ["editor_skip", "low_score"] } },
        "required": ["drop_reason"]
      },
      "then": {
        "required": ["notes"],
        "properties": {
          "notes": { "type": "string", "minLength": 1 }
        }
      }
    }
  ]
}
