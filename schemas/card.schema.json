{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ruiyaoe-hash.github.io/ai-radar/schemas/card.schema.json",
  "title": "AI Radar Event Card",
  "type": "object",
  "required": ["schema_version", "id", "status", "tag", "lens", "priority", "title", "date", "objective", "sources"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": "integer", "const": 2 },
    "id": {
      "type": "string",
      "pattern": "^evt-[0-9]{8}-[a-z0-9][a-z0-9-]{0,80}$"
    },
    "status": { "type": "string", "enum": ["rumor", "multi_source", "confirmed"] },
    "tag": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16,
      "description": "Short event type. Rewritten label, not a raw post."
    },
    "lens": { "type": "string", "enum": ["工具", "赛道", "模式", "时机"] },
    "priority": { "type": "string", "enum": ["P0", "P1"] },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "One rewritten headline. Not a raw social post."
    },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "time": {
      "type": "string",
      "maxLength": 11,
      "pattern": "^[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}$",
      "description": "Beijing display clock, MM-DD HH:MM."
    },
    "handle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[^\\s<>]{1,40}$"
    },
    "url": {
      "type": "string",
      "maxLength": 500,
      "pattern": "^https?://[^\\s<>]+$",
      "description": "Primary link. http or https only."
    },
    "objective": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "description": "Edited factual sentences. Public cards carry this summary, not a raw social post body.",
      "items": { "type": "string", "minLength": 1, "maxLength": 400 }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["url", "handle", "role"],
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 500,
            "pattern": "^https?://[^\\s<>]+$"
          },
          "handle": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "^[^\\s<>]{1,40}$"
          },
          "role": { "type": "string", "enum": ["primary", "analysis", "report"] },
          "first_seen_at": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "correction": {
      "type": ["object", "null"],
      "properties": {
        "at": { "type": "string", "maxLength": 40 },
        "note": { "type": "string", "maxLength": 240 },
        "previous_status": { "type": "string", "maxLength": 32 }
      }
    },
    "judgment": {
      "type": "array",
      "maxItems": 6,
      "items": { "type": "string", "minLength": 1, "maxLength": 240 }
    },
    "judgment_label": { "type": "string", "maxLength": 16 },
    "so_what": {
      "type": "object",
      "required": ["falsifier"],
      "properties": {
        "lens": { "type": "string", "enum": ["工具", "赛道", "模式", "时机"] },
        "impact": { "type": "string", "maxLength": 320 },
        "action": { "type": "string", "maxLength": 24 },
        "window": { "type": "string", "maxLength": 80 },
        "confidence": { "type": "string", "enum": ["高", "中", "低"] },
        "falsifier": { "type": "string", "minLength": 1, "maxLength": 320 },
        "thesis_id": { "type": "string", "pattern": "^T-[0-9]{3,}$", "maxLength": 16 }
      },
      "additionalProperties": true
    },
    "try_url": {
      "type": "string",
      "maxLength": 500,
      "pattern": "^https?://[^\\s<>]+$"
    },
    "access": { "type": "string", "maxLength": 400 },
    "integration": { "type": "string", "maxLength": 200 },
    "first_step": { "type": "string", "maxLength": 240 },
    "alternatives": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1, "maxLength": 80 }
    },
    "tool_radar": {
      "type": "string",
      "enum": ["采纳", "试用", "评估", "暂缓"]
    },
    "lead_lag_hours": {
      "type": ["number", "null"],
      "description": "Assumed hours from the display source clock to the next publish slot. Not the measured lag."
    },
    "lead_lag_basis": {
      "type": "string",
      "description": "assumed_next_digest when filled by migrate. Leave this pair in place. Measured first-report lag is ingested_at − published_at when both stamps are present."
    },
    "published_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|\\+00:00)$",
      "description": "Recommended on new cards, optional on legacy cards. Original post/publish time, ISO-8601 UTC (Z or +00:00). Set from a source clock such as X created_at or RSS pubDate. Omit when the source has no time; do not guess."
    },
    "ingested_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|\\+00:00)$",
      "description": "Recommended on new cards, optional on legacy cards. When the card was first written onto the archive board, ISO-8601 UTC. Set once; do not refresh on later edits. Measured lag hours = ingested_at − published_at when both are present."
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^cand-[0-9]{8}-[a-f0-9]{12}$",
      "description": "Pool cid this card was promoted from. Required on archive cards dated on or after config.json pool_traceability_since, unless promotion_path is emergency. Omit on legacy cards."
    },
    "promotion_path": {
      "type": "string",
      "enum": ["normal", "emergency"],
      "description": "normal = promoted from a pool record. emergency = written onto the archive without a pool row. Omit on legacy cards."
    },
    "shift": {
      "type": "string",
      "enum": ["morning", "midday", "evening", "other"],
      "description": "morning = 08:00 Asia/Shanghai 主报 (daily). evening = 21:00 Asia/Shanghai 晚班 (Mon–Fri). midday is legacy from the removed 13:30 slot. other = outside publish slots."
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["so_what"],
        "properties": { "so_what": { "type": "object" } }
      },
      "then": {
        "properties": {
          "so_what": {
            "required": ["falsifier"],
            "properties": {
              "falsifier": { "type": "string", "minLength": 1, "maxLength": 320 }
            }
          }
        }
      }
    }
  ]
}
