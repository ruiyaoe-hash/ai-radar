{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ruiyaoe-hash.github.io/ai-radar/schemas/card.schema.json",
  "title": "AI Radar Event Card",
  "type": "object",
  "required": ["schema_version", "id", "status", "tag", "lens", "priority", "title", "date", "objective", "sources"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": "integer", "const": 2 },
    "id": {
      "type": "string",
      "pattern": "^evt-[0-9]{8}-[a-z0-9][a-z0-9-]{0,80}$"
    },
    "status": { "type": "string", "enum": ["rumor", "multi_source", "confirmed"] },
    "tag": { "type": "string", "minLength": 1 },
    "lens": { "type": "string", "enum": ["工具", "赛道", "模式", "时机"] },
    "priority": { "type": "string", "enum": ["P0", "P1"] },
    "title": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "time": { "type": "string" },
    "handle": { "type": "string" },
    "url": { "type": "string" },
    "objective": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["url", "handle", "role"],
        "properties": {
          "url": { "type": "string" },
          "handle": { "type": "string" },
          "role": { "type": "string", "enum": ["primary", "analysis", "report"] },
          "first_seen_at": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "correction": {
      "type": ["object", "null"],
      "properties": {
        "at": { "type": "string" },
        "note": { "type": "string" },
        "previous_status": { "type": "string" }
      }
    },
    "judgment": {
      "type": "array",
      "items": { "type": "string" }
    },
    "judgment_label": { "type": "string" },
    "so_what": {
      "type": "object",
      "required": ["falsifier"],
      "properties": {
        "lens": { "type": "string", "enum": ["工具", "赛道", "模式", "时机"] },
        "impact": { "type": "string" },
        "action": { "type": "string" },
        "window": { "type": "string" },
        "confidence": { "type": "string", "enum": ["高", "中", "低"] },
        "falsifier": { "type": "string", "minLength": 1 },
        "thesis_id": { "type": "string" }
      },
      "additionalProperties": true
    },
    "try_url": { "type": "string" },
    "access": { "type": "string" },
    "integration": { "type": "string" },
    "first_step": { "type": "string" },
    "alternatives": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tool_radar": {
      "type": "string",
      "enum": ["采纳", "试用", "评估", "暂缓"]
    },
    "lead_lag_hours": { "type": ["number", "null"] },
    "lead_lag_basis": {
      "type": "string",
      "description": "assumed_next_digest when filled by migrate; Alba may replace lead_lag_hours with a measured value"
    },
    "shift": { "type": "string", "enum": ["morning", "midday", "evening", "other"] }
  },
  "allOf": [
    {
      "if": {
        "required": ["so_what"],
        "properties": { "so_what": { "type": "object" } }
      },
      "then": {
        "properties": {
          "so_what": {
            "required": ["falsifier"],
            "properties": {
              "falsifier": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  ]
}
