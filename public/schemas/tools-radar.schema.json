{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ruiyaoe-hash.github.io/ai-radar/schemas/tools-radar.schema.json",
  "title": "AI Radar tools radar",
  "description": "Derived tool list at tools-radar.json. This document has no schema_version. Incompatible shape changes are recorded in CHANGELOG.md. Deprecated fields stay at least 90 days. Ring keys are 采纳, 试用, 评估, 暂缓 (human labels: 值得用上, 可以试, 先评估, 先别跟).",
  "type": "object",
  "required": ["updated", "rings", "note"],
  "additionalProperties": true,
  "properties": {
    "updated": {
      "type": "string",
      "minLength": 1,
      "description": "When this file was derived, as a Beijing-time display string."
    },
    "note": { "type": "string", "minLength": 1, "maxLength": 160 },
    "rings": {
      "type": "object",
      "required": ["采纳", "试用", "评估", "暂缓"],
      "additionalProperties": false,
      "properties": {
        "采纳": { "$ref": "#/$defs/ring" },
        "试用": { "$ref": "#/$defs/ring" },
        "评估": { "$ref": "#/$defs/ring" },
        "暂缓": { "$ref": "#/$defs/ring" }
      }
    }
  },
  "$defs": {
    "ring": {
      "type": "array",
      "items": { "$ref": "#/$defs/tool" }
    },
    "tool": {
      "type": "object",
      "required": ["id", "title", "date", "alternatives", "status", "priority"],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^evt-[0-9]{8}-[a-z0-9][a-z0-9-]{0,80}$"
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "try_url": {
          "type": ["string", "null"],
          "maxLength": 500,
          "pattern": "^https?://[^\\s<>]+$"
        },
        "access": { "type": ["string", "null"], "maxLength": 400 },
        "integration": { "type": ["string", "null"], "maxLength": 200 },
        "first_step": { "type": ["string", "null"], "maxLength": 240 },
        "alternatives": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 80 }
        },
        "status": { "type": "string", "enum": ["rumor", "multi_source", "confirmed"] },
        "priority": { "type": "string", "enum": ["P0", "P1"] }
      }
    }
  }
}
