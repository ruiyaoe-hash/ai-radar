{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ruiyaoe-hash.github.io/ai-radar/schemas/atlas.schema.json",
  "title": "AI Radar 实战图谱",
  "description": "Topic atlas at data/kb.json. schema_version is 1. Optional fields may be added without a bump. Deprecated fields stay at least 90 days. See CHANGELOG.md. Tracks, topics, sources, and creators are also split into data/tracks.json, data/topics.json, data/sources.json, and data/creators.json.",
  "type": "object",
  "required": ["schema_version", "snapshot", "tracks", "topics", "sources", "creators"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "snapshot": { "type": "string", "minLength": 8, "maxLength": 32 },
    "updated": { "type": ["string", "null"], "maxLength": 48 },
    "note": { "type": "string", "maxLength": 500 },
    "tracks": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/track" }
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/topic" }
    },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" }
    },
    "creators": {
      "type": "array",
      "items": { "$ref": "#/$defs/creator" }
    }
  },
  "$defs": {
    "track": {
      "type": "object",
      "required": ["id", "name", "tagline"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,40}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 20 },
        "tagline": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "playbook_step": {
      "type": "object",
      "required": ["title", "detail", "sources"],
      "additionalProperties": true,
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "detail": { "type": "string", "minLength": 1, "maxLength": 400 },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 80 }
        }
      }
    },
    "topic": {
      "type": "object",
      "required": ["slug", "name", "track", "summary", "audience", "tools", "playbook", "pitfalls", "status", "source_count", "creator_count"],
      "additionalProperties": true,
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "track": { "type": "string", "minLength": 1, "maxLength": 40 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 400 },
        "audience": { "type": "string", "minLength": 1, "maxLength": 120 },
        "tools": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 40 }
        },
        "playbook": {
          "type": "array",
          "items": { "$ref": "#/$defs/playbook_step" }
        },
        "pitfalls": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 240 }
        },
        "status": { "type": "string", "enum": ["active", "待采集"] },
        "source_count": { "type": "integer", "minimum": 0 },
        "creator_count": { "type": "integer", "minimum": 0 },
        "bookmarks": { "type": "integer", "minimum": 0 },
        "likes": { "type": "integer", "minimum": 0 },
        "save_ratio": { "type": "number", "minimum": 0 },
        "latest": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "has_bookmarks": { "type": "boolean" }
      }
    },
    "source": {
      "type": "object",
      "required": ["id", "url", "author", "topic", "type", "title", "excerpt", "date", "origin"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,80}$" },
        "url": { "type": "string", "maxLength": 500, "pattern": "^https?://[^\\s<>]+$" },
        "author": { "type": "string", "minLength": 1, "maxLength": 80 },
        "topic": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "type": { "type": "string", "enum": ["教程", "实战项目", "工具/开源", "方法论", "资源合集"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "excerpt": { "type": "string", "minLength": 1, "maxLength": 500 },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "likes": { "type": "integer", "minimum": 0 },
        "bookmarks": { "type": "integer", "minimum": 0 },
        "views": { "type": "integer", "minimum": 0 },
        "origin": { "type": "string", "enum": ["prototype-snapshot", "practice"] }
      }
    },
    "creator": {
      "type": "object",
      "required": ["handle", "name", "focus", "profile_url", "source_count", "bookmarks", "topics", "bookmark_metric"],
      "additionalProperties": true,
      "properties": {
        "handle": { "type": "string", "minLength": 1, "maxLength": 40 },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "followers": { "type": "integer", "minimum": 0 },
        "focus": { "type": "string", "maxLength": 80 },
        "profile_url": { "type": "string", "maxLength": 500, "pattern": "^https?://[^\\s<>]+$" },
        "source_count": { "type": "integer", "minimum": 0 },
        "bookmarks": { "type": "integer", "minimum": 0 },
        "bookmark_metric": { "type": "boolean" },
        "topics": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
        }
      }
    }
  }
}
